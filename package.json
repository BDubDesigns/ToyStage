{
  "name": "toystage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/verify-pose-assets.mjs && node scripts/verify-benchmark-assets.mjs && vite",
    "build": "node scripts/verify-pose-assets.mjs && node scripts/verify-benchmark-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/browser-pose-check.mjs",
    "test:benchmark": "npm run build && node scripts/browser-benchmark-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@tensorflow-models/pose-detection": "2.1.3",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0"
  }
}
